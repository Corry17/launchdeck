# 本地模式仅监听回环地址，不可作为公网生产环境。
APP_MODE=local
CONSOLE_ORIGIN=http://localhost:3000
API_PORT=4310
# 留空时使用 .data/postgres 中的内嵌 PostgreSQL。
DATABASE_URL=
# 留空时使用数据库 outbox 调度；配置后使用 BullMQ 派发。
REDIS_URL=
# 生产环境必须显式提供 32 字节密钥的 Base64 值；不要提交真实密钥。
MASTER_KEY_BASE64=
# GitHub OAuth 回调：http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 生产环境只允许明确邀请的 GitHub 数字用户 ID，以逗号分隔。
ALLOWED_GITHUB_IDS=
# GitHub App 用于公有/私有仓库读取，私钥存放在环境变量中。
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=
# 至少 32 字符的随机值，与 GitHub 仓库 Webhook Secret 完全一致，不在前端填写。
# 接收地址为 CONSOLE_ORIGIN/api/hooks/github；公网须使用 HTTPS，并开启 GitHub SSL verification。
GITHUB_WEBHOOK_SECRET=
# 控制台改端口时通过 shell 同时设置 CONSOLE_PORT 和 CONSOLE_ORIGIN，再运行 npm run dev。
# 构建模板均需独立签名/发布节点验证后才启用，不自动开通付费资源。
