{
  "name": "launchdeck",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others -n api,console -c blue,magenta \"npm:dev:api\" \"npm:dev:console\"",
    "dev:api": "tsx --tsconfig tsconfig.api.json apps/api/src/main.ts",
    "dev:console": "next dev apps/console --hostname 127.0.0.1 --port ${CONSOLE_PORT:-3000}",
    "build": "npm run typecheck && next build apps/console",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --tsconfig tsconfig.api.json --test tests/*.test.ts",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=.data/browsers playwright test",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css,mjs,json}\" \"packages/**/*.{ts,tsx}\" \"tests/**/*.ts\" --ignore-path .gitignore",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "start:api": "NODE_ENV=production tsx --tsconfig tsconfig.api.json apps/api/src/main.ts",
    "start:console": "next start apps/console --hostname 127.0.0.1 --port ${CONSOLE_PORT:-3000}"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "@nestjs/platform-express": {
      "multer": "2.3.0"
    }
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "bullmq": "^5.58.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "ioredis": "^5.8.0",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^0.468.0",
    "next": "16.3.4",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tailwind-merge": "^3.0.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^9.1.2",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2"
  }
}
